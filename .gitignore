# Third-party runtimes and tools for the Windows installer (JRE 8, JDK 17, Node,
# MongoDB, NSSM) must be downloaded separately and placed under these paths before building the installer. See the README "Installer
# runtimes" section for exact versions and where to download them.
/runtime/
/tools/

# "Compilador" used as backend for the service (built jar + solc/vyper binaries).
# Built with "mvnw clean package" and copied here - see README.
/compiler/

# Installer generated by Inno Setup (build output, hundreds of MB, not source code)
/installer/Output/

# Logs generated at runtime (local and from the installer's Windows services)
/logs/
smacly-web/logs/*.log
