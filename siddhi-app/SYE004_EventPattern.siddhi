@App:name('SYE004_EventPattern')
@App:description('CEP Application for events received from SmaCly')

@sink(type = 'http', publisher.url = "http://localhost:1880/event-state/sye004", sink.id = "SYE004-validation", method = "POST", 
	@map(type = 'json',
	    @payload("""{"Timestamp":"{{timestamp}}", "Topic":"sye004", "IdSession":"{{idSession}}", "Param1":"{{name}}", "State":{{duplicated}}, "BlockId":"{{blockId}}"}""")))
define stream SYE004ValidationStream (timestamp string, idSession string, name string, total long, blockId string, duplicated int);

@source(type = 'http', receiver.url = "http://localhost:1080/get-sye004", socketIdleTimeout = "150000",	@map(type = 'json',
	@attributes(timestamp='$.timestamp',idSession='$.idSession', name='$.name', blockId ='$.blockId')))
define stream SYE004Stream (timestamp string, idSession string, name string, blockId string);

@source(type = 'http-response', sink.id = "SYE004-validation", http.status.code = "500", 
	@map(type = 'json', 
		@attributes(failureReason = "validation-response.reason", idSession = "trp:idSession")))
define stream Failure500SYE004ValidationRequestStream (idSession string, failureReason string);

-- Those with 400 status code
@source(type = 'http-response', sink.id = "SYE004-validation", http.status.code = "400", 
	@map(type = 'json', 
		@attributes(failureReason = "validation-response.reason", idSession = "trp:idSession")))
define stream FailureSYE004ValidationRequestStream (idSession string, failureReason string);

 
-- Those with 2XX status code
@source(type = 'http-response', sink.id = "SYE004-validation", http.status.code = "2\d+", 
	@map(type = 'json', 
		@attributes(idSession = "trp:idSession")))
define stream SuccessSYE004ValidationRequestStream (idSession string);

define stream SYE004VisibilityCountTable (timestamp string, idSession string, name string, blockId string, total long);

--Process requests and generate a response message
@sink(type = 'log', 
	@map(type = 'text'))
define stream SYE004ValidationResponseStream (idSession string, message string);
 
@info(name = 'String version to numeric query')
from SYE004Stream 
select timestamp, idSession, name, blockId, count(name) as total
group by timestamp, idSession, name
insert into SYE004VisibilityCountTable;

@info(name = 'Insert data in http endpoint')
from SYE004VisibilityCountTable 
select timestamp, idSession, name, total, blockId, ifThenElse(total > 1, 1, 0) as duplicated
group by timestamp, idSession, name
insert into SYE004ValidationStream;

--@info(name = 'Insert data in http endpoint')
--from SYE004VisibilityCountTable 
--select * 
--insert into SYE004ValidationStream;

@info(name = 'successful-message-generator')
from SuccessSYE004ValidationRequestStream 
select idSession, "Event request is accepted for processing" as message 
insert into SYE004ValidationResponseStream;

@info(name = 'failure-message-generator')
from FailureSYE004ValidationRequestStream 
select idSession, str:concat("Event request is rejected due to ", failureReason) as message 
insert into SYE004ValidationResponseStream;

@info(name = 'failure-message-generator-500')
from Failure500SYE004ValidationRequestStream 
select idSession, str:concat("Event request is rejected due to ", failureReason) as message 
insert into SYE004ValidationResponseStream;
