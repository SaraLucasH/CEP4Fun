@App:name('NTD004_EventPattern')
@App:description('CEP Application for events received from SmaCly')

@sink(type = 'http', publisher.url = "http://localhost:1880/event-state/ntd004", sink.id = "NTD004-validation", method = "POST", 
	@map(type = 'json',
		@payload("""{"Timestamp":"{{timestamp}}", "Topic":"ntd004","IdSession":"{{idSession}}","Param1":"{{name}}", "State":{{properInheritance}}, "BlockId":"{{blockId}}"}""")))
define stream NTD004ValidationStream (timestamp string, idSession string, name string, total long, blockId string, properInheritance int);

@source(type = 'http', receiver.url = "http://localhost:1080/get-ntd004", socketIdleTimeout = "150000",	@map(type = 'json',
	@attributes(timestamp='$.timestamp',idSession='$.idSession', name='$.name', values_visibility ='$.values_visibility', values_inputmodifier ='$.values_inputmodifier', parent ='$.parent', blockId ='$.blockId')))
define stream NTD004Stream (timestamp string, idSession string, name string, values_visibility string, values_inputmodifier string, parent string, blockId string);

@source(type = 'http-response', sink.id = "NTD004-validation", http.status.code = "500", 
	@map(type = 'json', 
		@attributes(failureReason = "validation-response.reason", idSession = "trp:idSession")))
define stream Failure500NTD004ValidationRequestStream (idSession string, failureReason string);

-- Those with 400 status code
@source(type = 'http-response', sink.id = "NTD004-validation", http.status.code = "400", 
	@map(type = 'json', 
		@attributes(failureReason = "validation-response.reason", idSession = "trp:idSession")))
define stream FailureNTD004ValidationRequestStream (idSession string, failureReason string);

 
-- Those with 2XX status code
@source(type = 'http-response', sink.id = "NTD004-validation", http.status.code = "2\d+", 
	@map(type = 'json', 
		@attributes(idSession = "trp:idSession")))
define stream SuccessNTD004ValidationRequestStream (idSession string);

define stream NTD004InheritanceCountTable (timestamp string, idSession string, name string, parent string, blockId string, total long);

--Process requests and generate a response message
@sink(type = 'log', 
	@map(type = 'text'))
define stream NTD004ValidationResponseStream (idSession string, message string);

 
@info(name = 'String version to numeric query')
from NTD004Stream 
select timestamp, idSession, name, parent, blockId, distinctCount(parent) as total
group by timestamp, idSession, name, values_visibility, values_inputmodifier, parent, blockId
insert into NTD004InheritanceCountTable;

@info(name = 'Insert data in http endpoint')
from NTD004InheritanceCountTable 
select timestamp, idSession, name, total, blockId, ifThenElse(total == 1, ifThenElse(parent == 'contract', 0, 1), 0) as properInheritance
group by timestamp, idSession, name, parent, total, blockId
insert into NTD004ValidationStream;

--@info(name = 'Insert data in http endpoint')
--from NTD004VisibilityCountTable 	
--select * 
--insert into NTD004ValidationStream;

@info(name = 'successful-message-generator')
from SuccessNTD004ValidationRequestStream 
select idSession, "Event request is accepted for processing" as message 
insert into NTD004ValidationResponseStream;

@info(name = 'failure-message-generator')
from FailureNTD004ValidationRequestStream 
select idSession, str:concat("Event request is rejected due to ", failureReason) as message 
insert into NTD004ValidationResponseStream;

@info(name = 'failure-message-generator-500')
from Failure500NTD004ValidationRequestStream 
select idSession, str:concat("Event request is rejected due to ", failureReason) as message 
insert into NTD004ValidationResponseStream;
