    {
      "parameters": {
        "jsCode": "// Cada /events-log, de cualquier topic, reinicia el contador de inactividad de 2 min\nconst data = $getWorkflowStaticData('global');\ndata.lastEventAt = Date.now();\ndata.prg001AlreadyFired = false;\nreturn $input.all();"
      },
      "id": "b2197cba-43da-49f7-a9f7-3a33b2be7e38",
      "name": "Raise PRG001",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst last = data.lastEventAt || now; \nconst idleMs = now - last;\nconst TWO_MINUTES = 2 * 60 * 1000;\nlet fire = false;\nif (idleMs >= TWO_MINUTES && !data.prg001AlreadyFired) {\n  fire = true;\n  data.prg001AlreadyFired = true; //Dont repeat. Fixing bug from node-red\n}\nreturn [{ json: { fire, idleMs } }];"
      },
